<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __APP_DIR__ and __HOME__ are replaced on install (see README).
     Runs at 07:10, 12:10 and 19:10, at load, and every 30 min (catch-up after sleep; launchd also runs a
     calendar job missed during sleep on wake). Each run exits quickly when the live site is already fresh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ee.maardu-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__APP_DIR__/timetable/mac-backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/maardu-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/maardu-backup.log</string>
</dict>
</plist>
